# ─────────────────────────────────────────────
# Shih-Fu API — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# PostgreSQL — Supabase or local
DATABASE_URL=postgresql://postgres:password@localhost:5432/shihfu_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://shihfu.in

# Frontend base URL — used to redirect back after Google OAuth consent
FRONTEND_URL=http://localhost:3000

# Encrypts stored OAuth tokens (e.g. connected Gmail accounts) at rest.
# Must be a 32-byte key, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Twilio — SMS (India DLT registered sender)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX
TWILIO_DLT_ENTITY_ID=your_dlt_entity_id
TWILIO_DLT_TEMPLATE_ID=your_dlt_template_id

# WhatsApp Business API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
# Approved template names from Meta Business Manager > Account Tools >
# Message Templates. Each template's body must be a single {{1}}
# placeholder — the app fills it with the full reminder/campaign text.
# Utility = service reminders, Marketing = festival/promo campaigns;
# Meta reviews and approves these two categories separately. Leave
# unset only for early testing — Meta rejects freeform text outside a
# 24h window since the customer last messaged the business.
WHATSAPP_TEMPLATE_NAME_UTILITY=shihfu_reminder
WHATSAPP_TEMPLATE_NAME_MARKETING=shihfu_promo
WHATSAPP_TEMPLATE_LANG=en

# Email — Google OAuth ("Connect your Gmail" in Account Settings)
# From Google Cloud Console > APIs & Services > Credentials, OAuth
# client (Web application). Redirect URI must exactly match what's
# registered there, e.g. https://api.shihfu.com/api/v1/email-auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/email-auth/google/callback

# Email — shared SMTP relay fallback (e.g. SendGrid, Zoho Mail), used
# only for businesses who haven't connected their own Google account
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM_NAME=Shih-Fu Notifications
SMTP_FROM_EMAIL=noreply@shihfu.in

# Cron — reminder processing schedule (every hour)
REMINDER_CRON_SCHEDULE=0 * * * *

# Logging
LOG_LEVEL=info
